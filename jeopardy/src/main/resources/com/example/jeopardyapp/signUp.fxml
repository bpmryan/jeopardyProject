<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="423.0" prefWidth="342.0" style="-fx-background-color: #001f5b;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.newproject2.SignupController">
    <Label alignment="CENTER" layoutX="49.0" layoutY="50.0" style="-fx-font-size: 30px; -fx-text-fill: #ffd700; -fx-background-color: #001f5b; -fx-font-weight: bold;" text="Signup">
        <font>
            <Font name="System Bold" size="41.0" />
        </font>
    </Label>
    <TextField fx:id="txtName" layoutX="77.0" layoutY="157.0" prefHeight="26.0" prefWidth="179.0" promptText="First Last" />
    <Label layoutX="57.0" layoutY="124.0" prefHeight="17.0" prefWidth="213.0" style="-fx-text-fill: #ffd700; -fx-font-weight: bold;" text="Name (First and Last Name)" />
    <Label layoutX="62.0" layoutY="192.0" style="-fx-text-fill: #ffd700; -fx-font-weight: bold;" text="Email" />
    <Label layoutX="65.0" layoutY="257.0" style="-fx-text-fill: #ffd700; -fx-font-weight: bold;" text="Password" />
    <TextField fx:id="txtEmail" layoutX="77.0" layoutY="218.0" prefHeight="26.0" prefWidth="179.0" promptText="firstlast@example.com" />
    <TextField fx:id="txtPassword" layoutX="77.0" layoutY="280.0" prefHeight="26.0" prefWidth="179.0" promptText="************" />
    <Button fx:id="confirmSignup" layoutX="77.0" layoutY="360.0" mnemonicParsing="false" onAction="#confirmSignupClick" prefHeight="26.0" prefWidth="65.0" style="-fx-background-color: #ffd700; -fx-text-fill: #001f5b; -fx-border-color: #ffffff; -fx-border-width: 3px; -fx-border-radius: 3px;" text="Signup" />
    <Button layoutX="199.0" layoutY="360.0" mnemonicParsing="false" onAction="#cancelSignup" style="-fx-background-color: #ffd700; -fx-text-fill: #001f5b; -fx-border-color: #ffffff; -fx-border-radius: 3px; -fx-border-width: 3px;" text="Cancel" />
   <Label fx:id="signupError" layoutX="82.0" layoutY="327.0" prefHeight="17.0" prefWidth="0.0" />
   <padding>
      <Insets bottom="10.0" />
   </padding>
</AnchorPane>
