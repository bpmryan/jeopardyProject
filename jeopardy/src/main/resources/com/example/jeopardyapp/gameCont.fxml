<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="681.0" spacing="12.0" style="-fx-background-color: #001f5b;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Label style="-fx-text-fill: #ffd700; -fx-font-size: 20px; -fx-font-weight: bold;" text="Jeopardy Game Creator Center" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnPreview" mnemonicParsing="false" text="Preview Board" />
            <Button fx:id="btnSaveAll" mnemonicParsing="false" text="Save All" />
            <Button fx:id="btnAddCategory" mnemonicParsing="false" text="Add Category" />
